# Copy this file to .env.local and fill in real values. .env.local is gitignored
# (matches the repo's `.env.*` rule) - it will never be committed.

# Random secret for Flask's signed session cookies, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
FLASK_SECRET_KEY=

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Either reuse the same client as the main mcaff-CLS site, or create a new one - either
# way, add this app's callback as an Authorized redirect URI on that client:
#   http://127.0.0.1:5000/auth/callback   (local dev)
#   https://<wherever this ends up hosted>/auth/callback   (once deployed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only Google accounts on this domain can sign in.
COMPANY_DOMAIN=mcaffeine.com

# Comma-separated emails auto-promoted to admin (assign access) on first login.
ADMIN_EMAILS=

# The RTO Calling Google Sheet - ID is the part of the URL between /d/ and /edit.
RTO_SHEET_ID=

# Service-account credential for reading/writing the sheet - same account already used
# by scripts/lib.py for the reports (needs Editor access on the sheet, not just Viewer,
# since this app writes dispositions back to it). Pick ONE:
#   GOOGLE_SA_KEY_FILE=C:\path\to\service-account.json
#   GOOGLE_SA_KEY_JSON={"type": "service_account", ...}    (paste the whole file's JSON)
# If neither is set, scripts/lib.py falls back to the path already used by the report
# scripts (see scripts/lib.py's get_sa_credential()).
GOOGLE_SA_KEY_FILE=
GOOGLE_SA_KEY_JSON=

# Optional - defaults to 5000
PORT=5000
