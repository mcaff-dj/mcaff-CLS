# Copy to .env.local and fill in - never commit the real file (already gitignored via .env.*)

# Supabase project (Project Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Shiprocket API user credentials (Shiprocket dashboard > Settings > API, create an API user -
# do NOT use your normal Shiprocket login here)
SHIPROCKET_EMAIL=api-user@example.com
SHIPROCKET_PASSWORD=your-shiprocket-api-password

# Flask session signing key, e.g. generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me
