# Subagent-driven-development scratch: task briefs, reports, review packages, ledgers
.superpowers/

# AWS access-key CSVs as the console hands them out. One of these was sitting untracked in
# the repo root on 2026-08-21, one `git add .` away from being pushed to a GitHub repo.
*accessKeys*.csv

# Build output + deploy_infra.sh scratch files (trust policies, env JSON) - 45MB+ of zips
lambda/dist/

# Row-level backups written before a destructive cleanup (scripts/collapse_duplicate_dispose_cycles.py).
# Real order ids, agent emails and dispositions - kept on the machine that ran the cleanup, never pushed.
data/cleanup-backups/
