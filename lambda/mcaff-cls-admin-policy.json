{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IamRoleFullManage",
      "Effect": "Allow",
      "Action": "iam:*",
      "Resource": "arn:aws:iam::157320387454:role/mcaff-cls-*"
    },
    {
      "Sid": "PassMcaffClsRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::157320387454:role/mcaff-cls-*",
      "Condition": {
        "StringEquals": { "iam:PassedToService": ["lambda.amazonaws.com", "scheduler.amazonaws.com"] }
      }
    },
    {
      "Sid": "LambdaFullManage",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:ap-south-1:157320387454:function:mcaff-cls-*"
    },
    {
      "Sid": "SchedulerFullManage",
      "Effect": "Allow",
      "Action": "scheduler:*",
      "Resource": "arn:aws:scheduler:ap-south-1:157320387454:*"
    },
    {
      "Sid": "SecretsFullManage",
      "Effect": "Allow",
      "Action": "secretsmanager:*",
      "Resource": "arn:aws:secretsmanager:ap-south-1:157320387454:secret:mcaff-cls/*"
    },
    {
      "Sid": "LogsFullManage",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": "arn:aws:logs:ap-south-1:157320387454:log-group:/aws/lambda/mcaff-cls-*"
    },
    {
      "Sid": "WhoAmI",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
